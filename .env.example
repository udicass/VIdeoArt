# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# ── Anthropic / Claude (optional) ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# ── Vercel KV (optional) ──────────────────────────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Ollama (optional) ────────────────────────────────────────────────────────
# Ollama runs locally on port 11434. No extra config needed — the app detects it automatically.
# Pull a model first: ollama pull gemma4
