# Copy this file to .env and fill in the values you need.
# .env is gitignored — never commit real keys.

# ── Anthropic / Claude (optional) ─────────────────────────────────────────────
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# ── Gemini (optional) ─────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# ── PayPal print checkout (optional) ─────────────────────────────────────────
# Keep sandbox enabled until a complete test payment succeeds.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox

# ── Vercel KV (optional) ──────────────────────────────────────────────────────
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# ACCESS_ALLOWED_EMAILS=udicass@gmail.com,vanessa@curatora.co,anna@dvs.art

# ── Ollama (optional) ────────────────────────────────────────────────────────
# Ollama runs locally on port 11434. No extra config needed — the app detects it automatically.
# Pull a model first: ollama pull gemma4

# ── China access fallback (optional) ─────────────────────────────────────────
# Redirect is hard-limited in code to gesture-3d-beta.vercel.app.
# Recommended production values:
# VITE_CHINA_ALT_URL=https://www.syntheticdesires.art/
# VITE_MOVIE_CDN_BASE_CHINA=/china-media
# VITE_CHINA_GATE_MODE=redirect
# VITE_CHINA_GATE_TITLE=Mainland China Access
# VITE_CHINA_GATE_MESSAGE=We detected that you may be visiting from Mainland China. If playback is unstable, you can open the China-optimized site instead.
# VITE_CHINA_GATE_BUTTON_LABEL=Open China site
# VITE_CHINA_GATE_DISMISS_LABEL=Stay here
# VITE_CHINA_GATE_TIMEOUT_MS=3500
